rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidService(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.price is number && data.price >= 0;
    }

    function isValidAppointment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.time is string && data.time.size() <= 16 &&
             data.price is number && data.price >= 0 &&
             data.status is string && data.status.size() <= 32;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Preset Services collection
    match /services/{serviceId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(serviceId) && incoming().userId == request.auth.uid && isValidService(incoming());
      allow update: if isSignedIn() && isValidId(serviceId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidService(incoming());
      allow delete: if isSignedIn() && isValidId(serviceId) && existing().userId == request.auth.uid;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(appointmentId) && incoming().userId == request.auth.uid && isValidAppointment(incoming());
      allow update: if isSignedIn() && isValidId(appointmentId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidAppointment(incoming());
      allow delete: if isSignedIn() && isValidId(appointmentId) && existing().userId == request.auth.uid;
    }
  }
}
